{
  "name": "agentlens",
  "version": "0.4.0",
  "private": true,
  "packageManager": "pnpm@12.22.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --ignore-pattern \"src/testing/lint-probe/**\" && eslint --max-warnings 0 \"**/*.html\" && stylelint --max-warnings 0 --ignore-pattern \"src/testing/lint-probe/**\" \"src/**/*.{ts,css}\"",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "docs:dev": "vitepress dev site",
    "docs:build": "vitepress build site",
    "docs:preview": "vitepress preview site",
    "docs:glossary": "UPDATE_GLOSSARY=1 vitest run site/tests/glossary.spec.ts",
    "build:demo": "ng build --base-href \"${DEMO_BASE:-/agentlens/app/}\"",
    "docs:assemble": "node site/scripts/assemble.mts"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.2",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@gravionlabs/helix-shell": "22.10.0",
    "@gravionlabs/helix-ui": "22.10.0",
    "@ngrx/signals": "^22.0.1",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "primeicons": "^8.0.2",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "22.5.0",
    "@angular-eslint/template-parser": "22.5.0",
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@gravionlabs/helix-lint": "22.10.0",
    "@tauri-apps/cli": "^2",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.2",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "postcss-angular": "2.0.0",
    "stylelint": "18.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.11"
  }
}
