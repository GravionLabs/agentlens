<?xml version="1.0" encoding="utf-8"?>
<!-- Adds the install directory (agentlens.exe and agentlens-mcp.exe) to the user PATH. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="AgentLensUserPath" Guid="22096FE2-2C38-4E7E-BD91-73FA5BBEC937">
        <RegistryValue Root="HKCU" Key="Software\GravionLabs\AgentLens" Name="PathEntry" Type="integer" Value="1" KeyPath="yes" />
        <Environment Id="AgentLensUserPathEntry" Name="PATH" Value="[INSTALLDIR]" Action="set" Part="last" System="no" Permanent="no" />
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
