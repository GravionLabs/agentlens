{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentLens",
  "mainBinaryName": "agentlens-app",
  "version": "0.3.0",
  "identifier": "dev.gravionlabs.agentlens",
  "build": {
    "beforeDevCommand": "pnpm run start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist/agentlens/browser"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AgentLens",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost"
      },
      "devCsp": null,
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
